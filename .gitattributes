# Text: Git detects text files by content and stores and checks them out with LF line endings.
* text=auto eol=lf

# Binary safety net for accidental adds: assets are distributed via i2pd torrents and never committed.
*.png binary
*.jpg binary
*.jpeg binary
*.ogg binary
*.wav binary
*.flac binary
*.mp3 binary
*.ttf binary
*.otf binary
*.pak binary
*.bin binary
