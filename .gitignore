# Cargo build output, written to target/ next to the workspace Cargo.toml at the repository root.
# Anchored and directory-only, so a file or directory named target or debug elsewhere stays tracked;
# target/debug/ lies inside it, so no separate debug pattern is needed.
/target/

# Backup files written by rustfmt
**/*.rs.bk

# Debug-information files written by MSVC-target builds of rustc
*.pdb

# Mutation-testing data written by cargo-mutants
**/mutants.out*/

# Stack traces that rustc writes to the working directory on an internal compiler error
rustc-ice-*.txt

# Local game assets — distributed via i2pd torrents, never committed
/assets/**
!/assets/.gitignore
!/assets/README.md

# Local AI model files
*.gguf
/models/

# Source analysis databases and caches
*.sqlite
*.sqlite3
/analysis-cache/
/artifacts/

# Local build output
/build/**
!/build/.gitkeep
